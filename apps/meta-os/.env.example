# Server only. Create at dev.meta.ai; never commit a real key.
MODEL_API_KEY=
# Keep disabled until real authenticated workspace access, quotas and rate limits exist.
META_REASONING_API_ENABLED=false
# Restricted integration-testing bearer for POST /api/meta/reason. High-entropy, server only.
META_REASONING_ACCESS_TOKEN=
# HMAC secret minting expiring per-workspace demo tokens. Generate with: openssl rand -hex 32
META_DEMO_TOKEN_SECRET=
# Live MARI diagnosis on POST /api/mission. Also requires the master switch plus a presented demo token.
MARI_LIVE_REASONING_ENABLED=false
# HMAC secret verifying human approval records. Generate with: openssl rand -hex 32
APPROVAL_HMAC_SECRET=
# Image generation on POST /api/creative/generate. Also requires the master switch, a key, and a presented demo token.
CREATIVE_GENERATION_ENABLED=false
# HMAC secret signing short-lived creative asset delivery URLs. Generate with: openssl rand -hex 32
ASSET_URL_SECRET=
# Local isolated creative storage root (server filesystem). Ephemeral on serverless; durable store pending approval.
CREATIVE_STORAGE_DIR=.data/creative
# Open-weight inference is a separate provider/host, not Meta Model API.
# Website evidence retrieval kill switch. Set to false to keep website input reference-only.
WEBSITE_INGEST_ENABLED=true
